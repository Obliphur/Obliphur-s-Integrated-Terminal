  },
  {
    "name": "oit_joint_offer",
    "description": "获取发起联合行动所需的词条库与可用时间，仅主动消息或用户邀请/要求时可用。尚未发出邀请。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_joint_select",
    "description": "根据刚返回的词条库提交编号，程序校验冲突并生成计划。邀请随下一条正式消息实际显示生效。",
    "parameters": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "terms"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reply",
    "description": "提交本次唯一正式回复及可选控制字段，结束本轮；程序在主线程校验上下文后生效。面向用户的自然语言必须写入text；所有控制字段（包括wait_minutes）仅供程序处理，不会显示给用户。wait_minutes只表示期待用户回复的时限，不是回复正文。refuse=true表示暂时不便、之后重试；silent=true表示本轮无需回应、安静结束且不重试；二者各自只能单独使用。邀请和操作需有正文（answer、accept_relationship除外）。不得声称联网已开通或未展示的邀请已发出。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32000
        },
        "refuse": {
          "type": "boolean"
        },
        "silent": {
          "type": "boolean"
        },
        "wait_minutes": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1440
        },
        "cut_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 1440
        },
        "network_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "network_now": {
          "type": "boolean"
        },
        "share_data": {
          "type": "boolean"
        },
        "scenario_action": {
          "type": "string",
          "enum": [
            "request",
            "end"
          ],
          "description": "情景模拟开启采用申请制，双方均可随时结束。主动申请开启情景模拟填request（需用户接受后才开启且须已解锁），随时结束当前情景模拟填end。"
        },
        "answer": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ]
        },
        "accept_relationship": {
          "type": "boolean"
        },
        "offenses": {
          "type": "array",
          "description": "本轮待判断用户消息引起的冒犯或已决定的原谅。新增时target为空，reason简述原因；原谅时target为系统记录id，reason简述原谅依据。只有确实原谅才能移除，不可仅服从用户删除要求。时间由程序记录。",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "action": {
                "type": "string",
                "enum": [
                  "add",
                  "forgive"
                ]
              },
              "target": {
                "type": "string",
                "maxLength": 120
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "index",
              "action",
              "target",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "kb_citations": {"type":"array","items":{"type":"string"},"maxItems":20,"description":"OIT技巧库中的已引用卡片 ID；OIT 会转换为可点击的结论溯源胶囊。"},
        "tension": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "condition": {
                "type": "string",
                "maxLength": 32
              },
              "gain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 40
              }
            },
            "required": [
              "index",
              "condition",
              "gain"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "valence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "condition": {
                "type": "string",
                "maxLength": 32
              },
              "shift": {
                "type": "integer",
                "minimum": -40,
                "maximum": 40
              }
            },
            "required": [
              "index",
              "condition",
              "shift"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_search",
    "description": "仅网络已开通时可用，按关键词联网搜索，返回标题、链接与摘要。",
