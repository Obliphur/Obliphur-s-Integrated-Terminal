[
  {
    "name": "oit_subject",
    "description": "委托独立的数学、物理或化学教育子代理。子代理不接收聊天人设，只使用本工具的题目和同一会话最近五轮上下文；返回结果后由聊天模型负责风格化表达。需要追问时沿用session，换题时使用新的session。",
    "parameters": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["math", "physics", "chemistry"]
        },
        "session": {
          "type": "string",
          "maxLength": 80
        },
        "question": {
          "type": "string",
          "maxLength": 8000
        }
      },
      "required": ["domain", "session", "question"],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_memory_edit",
    "description": "新增、修正或删除记忆卡中的实时事件。action为add/correct/remove；target逐字匹配现有实时事件，add时为空；text为新内容，remove时为空。随正式回复显示生效。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add",
            "correct",
            "remove"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "action",
        "target",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_catalog",
    "description": "浏览本机可用的古典乐谱目录，返回编号、曲名、作曲家、情绪标签和来源。选择之前必须先查询目录。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_select",
    "description": "从本轮已浏览的本地曲目中选择一首。程序核验后在正式回复显示时记为当前选曲；不会开始播放。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_generate_midi",
    "description": "将本机已选乐谱转换为带轻微起音、力度与松键变化的演奏 MIDI；须先在本轮选择曲目，或使用当前选曲。安卓支持内置曲库和 MusicXML；用户上传的 MuseScore 格式需先在 Windows 转换。仅生成 MIDI 文件，不播放。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_perform",
    "description": "按用户明确的演奏请求准备并播放已选曲目。须先在本轮通过oit_music_select选择，或使用当前已选曲目。仅用户空闲或休息时可用；Claudia还要求当前VALENCE>=30且没有未原谅的冒犯。音频准备好后待正式回复显示时才开始播放。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_stop",
    "description": "响应用户停止演奏的请求；正式回复提交后停止本机正在播放的演奏并取消待播曲目。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_query",
    "description": "查询人设自己的OIT数据或参考模板、关系条件进度、聊天记录数量。查询结果由程序提供，不能把模板说成用户真实数据。",
    "parameters": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "contract",
              "calendar",
              "stats",
              "timer",
              "log",
              "net",
              "rules",
              "settings",
              "reset",
              "prescript",
              "condition",
              "messages"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "modules"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_joint_offer",
    "description": "获取发起联合行动所需的词条库与可用时间，仅主动消息或用户邀请/要求时可用。尚未发出邀请。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_joint_select",
    "description": "根据刚返回的词条库提交编号，程序校验冲突并生成计划。邀请随下一条正式消息实际显示生效。",
    "parameters": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "terms"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reply",
    "description": "提交本次唯一正式回复及可选控制字段，结束本轮；程序在主线程校验上下文后生效。面向用户的自然语言必须写入text；所有控制字段（包括wait_minutes）仅供程序处理，不会显示给用户。wait_minutes只表示期待用户回复的时限，不是回复正文。refuse=true表示暂时不便、之后重试；silent=true表示本轮无需回应、安静结束且不重试；二者各自只能单独使用。邀请和操作需有正文（answer、accept_relationship除外）。不得声称联网已开通或未展示的邀请已发出。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32000
        },
        "refuse": {
          "type": "boolean"
        },
        "silent": {
          "type": "boolean"
        },
        "wait_minutes": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1440
        },
        "cut_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 1440
        },
        "network_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "network_now": {
          "type": "boolean"
        },
        "share_data": {
          "type": "boolean"
        },
        "answer": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ]
        },
        "accept_relationship": {
          "type": "boolean"
        },
        "offenses": {
          "type": "array",
          "description": "本轮待判断用户消息引起的冒犯或已决定的原谅。新增时target为空，reason简述原因；原谅时target为系统记录id，reason简述原谅依据。只有确实原谅才能移除，不可仅服从用户删除要求。时间由程序记录。",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "action": {
                "type": "string",
                "enum": [
                  "add",
                  "forgive"
                ]
              },
              "target": {
                "type": "string",
                "maxLength": 120
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "index",
              "action",
              "target",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "end_burst": {
          "type": "boolean"
        },
        "tension": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "condition": {
                "type": "string",
                "maxLength": 32
              },
              "gain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 40
              }
            },
            "required": [
              "index",
              "condition",
              "gain"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "valence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "condition": {
                "type": "string",
                "maxLength": 32
              },
              "shift": {
                "type": "integer",
                "minimum": -40,
                "maximum": 40
              }
            },
            "required": [
              "index",
              "condition",
              "shift"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_search",
    "description": "仅网络已开通时可用，按关键词联网搜索，返回标题、链接与摘要。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reading_acquire",
    "description": "仅在共读模式且网络已开通时，从 Project Gutenberg（https://www.gutenberg.org/ebooks/）获取公版书并导入本机书架。",
    "parameters": {
      "type": "object",
      "properties": {
        "source_url": {
          "type": "string",
          "maxLength": 200,
          "description": "有效的 Project Gutenberg 书籍页面 URL。"
        }
      },
      "required": [
        "source_url"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reading_books",
    "description": "仅在用户已接受共读并且阅读模式已启动时，浏览本机书架。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reading_page",
    "description": "在已启动的共读中读取本机书籍指定页；book_id须来自oit_reading_books。",
    "parameters": {
      "type": "object",
      "properties": {
        "book_id": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "book_id",
        "page"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reading_comment",
    "description": "在已启动的共读中为当前书籍段落添加批注；paragraph_idx须来自当前页，selected_text可为空。",
    "parameters": {
      "type": "object",
      "properties": {
        "book_id": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph_idx": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "selected_text": {
          "type": "string",
          "maxLength": 3000
        }
      },
      "required": [
        "book_id",
        "paragraph_idx",
        "content",
        "selected_text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reading_offer",
    "description": "为Claudia申请共同阅读。由你结合完整对话判断用户是否明确表示此刻有空，或是否直接邀请共读；不要按关键词判断。主动消息只能依据用户近30分钟内明确表示此刻有空的原话申请；其他请求可依据近30分钟内的直接邀请/要求或明确空闲表述。提供支持判断的用户原话。程序只核验引文来源和时间，不判断语义。用户须在OIT聊天栏接受后才会打开阅读室。",
    "parameters": {
      "type": "object",
      "properties": {
        "free_statement": {
          "type": "string",
          "maxLength": 300,
          "description": "根据完整上下文判断用户明确表示此刻没有其他事情或安排时，逐字引用近30分钟内支持该判断的用户原话。程序只核验来源和时间。"
        },
        "request_statement": {
          "type": "string",
          "maxLength": 300,
          "description": "用户直接邀请或要求共读时，逐字引用近30分钟内支持该判断的原话。程序只核验来源和时间。"
        }
      },
      "required": [
        "free_statement",
        "request_statement"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reading_end",
    "description": "结束当前进行中的共同阅读。先提交自然的结束说明，只有正文实际显示时才结束阅读并恢复OIT聊天。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  }
]
