[
  {
    "name": "oit_music_catalog",
    "description": "浏览本机可用的古典乐谱目录，返回编号、曲名、作曲家、情绪标签和来源。选择之前必须先查询目录。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_select",
    "description": "从本轮已浏览的本地曲目中选择一首。程序核验后在正式回复显示时记为当前选曲；不会开始播放。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 }
      },
      "required": ["id"],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_music_generate_midi",
    "description": "将已选本机乐谱导出为带轻微起音、力度与松键变化的演奏 MIDI；须在本轮先选择，或已是当前选曲。需要 Windows 已部署 MuseScore。仅生成 MIDI 文件，不播放，也不代表 MP3 已生成。",
    "parameters": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 }
      },
      "required": ["id"],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_query",
    "description": "查询人设自己的OIT数据或参考模板、关系条件进度、聊天记录数量。查询结果由程序提供，不能把模板说成用户真实数据。",
    "parameters": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "contract",
              "calendar",
              "stats",
              "timer",
              "log",
              "net",
              "rules",
              "settings",
              "reset",
              "prescript",
              "condition",
              "messages"
            ]
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "modules"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_joint_offer",
    "description": "获取发起联合行动所需的词条库与可用时间，仅主动消息或用户邀请/要求时可用。尚未发出邀请。",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_joint_select",
    "description": "根据刚返回的词条库提交编号，程序校验冲突并生成计划。邀请随下一条正式消息实际显示生效。",
    "parameters": {
      "type": "object",
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [
        "terms"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_reply",
    "description": "提交本次唯一正式回复及可选控制字段，结束本轮；程序在主线程校验上下文后生效。面向用户的自然语言必须写入text；所有控制字段（包括wait_minutes）仅供程序处理，不会显示给用户。wait_minutes只表示期待用户回复的时限，不是回复正文。refuse=true只能单独使用。邀请和操作需有正文（answer、accept_relationship除外）。不得声称联网已开通或未展示的邀请已发出。",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 32000
        },
        "refuse": {
          "type": "boolean"
        },
        "wait_minutes": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 1440
        },
        "cut_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 1440
        },
        "network_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "share_data": {
          "type": "boolean"
        },
        "answer": {
          "type": "string",
          "enum": [
            "yes",
            "no"
          ]
        },
        "accept_relationship": {
          "type": "boolean"
        },
        "end_burst": {
          "type": "boolean"
        },
        "tension": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999
              },
              "condition": {
                "type": "string",
                "maxLength": 32
              },
              "gain": {
                "type": "integer",
                "minimum": 0,
                "maximum": 40
              }
            },
            "required": [
              "index",
              "condition",
              "gain"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        },
        "valence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": { "type": "integer", "minimum": 1, "maximum": 99999 },
              "condition": { "type": "string", "maxLength": 32 },
              "shift": { "type": "integer", "minimum": -40, "maximum": 40 }
            },
            "required": ["index", "condition", "shift"],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 100
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_search",
    "description": "仅网络已开通时可用，按关键词联网搜索，返回标题、链接与摘要。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  }
]
