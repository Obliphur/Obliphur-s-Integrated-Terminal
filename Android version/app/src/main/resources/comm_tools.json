[
  {
    "name": "oit_subject",
    "description": "委托独立的解题子代理，统一负责各学科解题（不限于数学、物理、化学）及知识库处理。知识库的分类、整理、补齐、复盘和提案均交给它。子代理不接收聊天人设，只使用本工具的任务和同一会话最近五轮上下文；返回结果后由聊天模型负责风格化表达。需要追问时沿用session，换题时使用新的session。",
    "parameters": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 60
        },
        "session": {
          "type": "string",
          "maxLength": 80
        },
        "question": {
          "type": "string",
          "maxLength": 8000
        }
      },
      "required": ["domain", "session", "question"],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_kb_search",
    "description": "查询 OIT 本地个人技巧库，概念性笔记绝不检索。先判断题目类型并用 problem_mode 标明是否要书写过程；卡片按通用性和思路参考设置筛选。先看 excluded_tactics 并遵守不考虑的技巧设置；只在前提满足时引用技巧。需要溯源时随后调用 oit_kb_trace。引用结论时在最终 oit_reply 的 kb_citations 中传卡片 ID。",
    "parameters": {"type":"object","properties":{"domain":{"type":"string","maxLength":60},"query":{"type":"string","maxLength":12000},"top_k":{"type":"integer","minimum":1,"maximum":20},"problem_mode":{"type":"string","enum":["answer_only","requires_working"]}},"required":["domain","query"],"additionalProperties":false}
  },
  {
    "name": "oit_kb_trace",
    "description": "读取技巧卡片的父结论链、适用前提和熟练度；概念卡不可查询。",
    "parameters": {"type":"object","properties":{"card_id":{"type":"string","maxLength":120}},"required":["card_id"],"additionalProperties":false}
  },
  {
    "name": "oit_kb_record_use",
    "description": "记录本题实际使用或确认失败的技巧卡片及题目摘要；只统计已检索到的技巧。",
    "parameters": {"type":"object","properties":{"used_card_ids":{"type":"array","items":{"type":"string"},"maxItems":20},"failed_card_ids":{"type":"array","items":{"type":"string"},"maxItems":20},"problem_summary":{"type":"string","maxLength":600}},"additionalProperties":false}
  },
  {
    "name": "oit_kb_propose",
    "description": "提交技巧库正文提案，需经用户审核后才合入。先调用 oit_kb_search 读取 excluded_tactics 并查重；符合排除描述的技巧不得提案，调用前原样填写 exclusions_considered。遵循「以补充为主，新增为辅」：库内已有核心相同或相近卡片时优先用 UPDATE_CARD / MERGE_ALIAS 补充原卡，严禁重复建卡。title 须规范命名：有公认专名或定理名时原样保留；无公认专名时尽量8字以内浓缩核心对象与方法词，不写完整句子、不带题号/具体数字/临时符号、不加冗余后缀、不含 Markdown/LaTeX；summary 仅用纯自然语言简短说明。",
    "parameters": {"type":"object","properties":{"action":{"type":"string","enum":["ADD_CARD","ADD_DERIVED","UPDATE_CARD","MERGE_ALIAS","REPARENT"]},"subject":{"type":"string","maxLength":60},"title":{"type":"string","maxLength":300},"target_card_id":{"type":"string","maxLength":120},"parent_ids":{"type":"array","items":{"type":"string"},"maxItems":20},"proposed_card":{"type":"object","properties":{"category":{"type":"string","maxLength":120},"topic":{"type":"string","maxLength":300},"aliases":{"type":"array","items":{"type":"string","maxLength":300},"maxItems":40},"triggers":{"type":"array","items":{"type":"string","maxLength":600},"maxItems":40},"statement":{"type":"string","maxLength":6000},"preconditions":{"type":"string","maxLength":6000},"proof_sketch":{"type":"string","maxLength":6000},"generality":{"type":"string","enum":["universal","explain_first","non_universal"]},"examples":{"type":"array","items":{"type":"string","maxLength":1500},"maxItems":20},"parent_ids":{"type":"array","items":{"type":"string","maxLength":120},"maxItems":20}},"additionalProperties":false},"summary":{"type":"string","maxLength":1500},"evidence":{"type":"array","items":{"type":"object","properties":{"ts":{"type":"string","maxLength":40},"problem":{"type":"string","maxLength":1200},"reason":{"type":"string","maxLength":1200}},"additionalProperties":false},"maxItems":20},"exclusions_considered":{"type":"string","maxLength":8000}},"required":["action","subject","title"],"additionalProperties":false}
  },
  {
    "name": "oit_answer_image",
    "description": "在解答图片模式开启、完成 oit_subject 且按人设风格化改写后调用，用于登记生成解答图片。成功后紧接着调用 oit_reply（气泡正文不含 Markdown/LaTeX 源码），图片将作为独立气泡发送，可在发图前后各加一句话（用 <oit_message> 分条并用独占一行的 <oit_answer_image> 指定发图位置）；解答图片模式关闭时无需调用。",
    "parameters": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "maxLength": 60
        },
        "session": {
          "type": "string",
          "maxLength": 80
        },
        "answer": {
          "type": "string",
          "maxLength": 8000
        },
        "styled_answer": {
          "type": "string",
          "maxLength": 8000
        }
      },
      "required": ["domain", "session", "answer", "styled_answer"],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_memory_edit",
    "description": "新增、修正或删除记忆卡中的实时事件。action为add/correct/remove；add时target为空、程序自动分配[#E*]编号；correct/remove时target可填短编号（如E1或#E1）或匹配原正文；text为新内容，remove时为空。随正式回复显示生效。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "add",
            "correct",
            "remove"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "action",
        "target",
        "text"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "oit_memory_search",
    "description": "按关键词或日期范围检索当前对话对象更早的本地归档聊天记录与历史消息（只读）。回忆往事、核对旧约定或用户提起很久以前的话题时按需调用；不要把检索结果伪称成用户刚刚说过的话。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "date_from": {
          "type": "string",
          "maxLength": 20
        },
        "date_to": {
          "type": "string",
          "maxLength": 20
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
