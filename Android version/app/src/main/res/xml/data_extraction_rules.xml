<?xml version="1.0" encoding="utf-8"?>
<!-- 不让数据被备份 / 换机迁移带走 (MECHANICS 9.3): 云备份和设备间迁移都排除全部内容 (allowBackup 也是 false) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
