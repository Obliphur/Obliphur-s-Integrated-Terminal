{
  "oit-lifecycle": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python ./scripts/hook_session_start.py",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python ./scripts/hook_pre_invocation.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "call_mcp_tool|.*oit_.*",
        "hooks": [
          {
            "type": "command",
            "command": "python ./scripts/hook_pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python ./scripts/hook_stop.py",
        "timeout": 10
      }
    ]
  }
}
